{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Big-Cycle-Monitor: statische Seite (public/) plus Worker für die täglichen Datenabrufe.
  // Der Cron-Trigger läuft alle zehn Minuten und arbeitet jeweils nur die fälligen Abrufjobs ab.
  // Name wie im Cloudflare-Dashboard (monitor.hartmann-it.workers.dev).
  "name": "monitor",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Ohne "id": Wrangler legt den KV-Namespace beim ersten Deploy automatisch an (automatic provisioning).
  "kv_namespaces": [
    { "binding": "DATA" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    // Höchstzahl Abrufjobs je Cron-Lauf (Workers Paid: 30 s CPU je Lauf, ein voller Umlauf dauert so rund 50 Minuten)
    "MAX_JOBS_PER_RUN": "8",
    // Externe Subrequests je Lauf (Workers Paid erlaubt deutlich mehr; die Grenze schont die Quellen)
    "SUBREQUEST_BUDGET": "80"
  },
  "observability": {
    "enabled": true
  }
  // Eigene Domain (erst eintragen, wenn die Zone hartmann-research.org im selben Cloudflare-Konto liegt):
  // "routes": [{ "pattern": "monitor.hartmann-research.org", "custom_domain": true }]
}
